---
layout: null
permalink: /atom.xml
---
{%- comment -%}
  Legacy feed path. /atom.xml has been live and indexed since the Poole-era
  site; jekyll-feed serves the canonical /feed.xml. Keeping both means no
  existing subscriber is silently orphaned. Do not delete.
{%- endcomment -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description | strip_newlines | strip }}</subtitle>
  <id>{{ site.url }}{{ site.baseurl }}/</id>
  <link href="{{ '/atom.xml' | absolute_url }}" rel="self"/>
  <link href="{{ '/' | absolute_url }}"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.author.name }}</name>
  </author>
  {%- for post in site.posts limit: 20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}"/>
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    {%- for tag in post.tags %}
    <category term="{{ tag | xml_escape }}"/>
    {%- endfor %}
    <summary type="html">{{ post.excerpt | strip_html | strip | xml_escape }}</summary>
    <content type="html">{{ post.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
